<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #0d1117;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PagoController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #161b22; -fx-padding: 12 25 12 25;">
            <Label text="nexo" textFill="#00d4ff">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Label text="Paso final de tu compra" textFill="#8b949e" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #0d1117; -fx-background: #0d1117;">
            <HBox spacing="30.0" style="-fx-padding: 40;" alignment="TOP_CENTER">

                <!-- Columna izquierda - Formulario de pago -->
                <VBox spacing="20.0" prefWidth="480">

                    <Label text="Metodo de pago" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="22.0" />
                        </font>
                    </Label>

                    <VBox spacing="14.0" style="-fx-background-color: #161b22; -fx-background-radius: 12; -fx-padding: 22;">

                        <Label text="Datos de la tarjeta" textFill="#00d4ff">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <VBox spacing="6.0">
                            <Label text="Numero de tarjeta" textFill="#c9d1d9" />
                            <TextField fx:id="txtNumeroTarjeta" promptText="ACCT-000003" prefHeight="40.0"
                                       style="-fx-background-color: #0d1117; -fx-text-fill: white; -fx-prompt-text-fill: #8b949e; -fx-border-color: #30363d; -fx-border-radius: 8; -fx-background-radius: 8;" />
                        </VBox>

                        <HBox spacing="12.0">
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label text="Fecha de expiracion" textFill="#c9d1d9" />
                                <TextField fx:id="txtExpiracion" promptText="MM/AA" prefHeight="40.0"
                                           style="-fx-background-color: #0d1117; -fx-text-fill: white; -fx-prompt-text-fill: #8b949e; -fx-border-color: #30363d; -fx-border-radius: 8; -fx-background-radius: 8;" />
                            </VBox>
                            <VBox spacing="6.0" prefWidth="140">
                                <Label text="CVV" textFill="#c9d1d9" />
                                <TextField fx:id="txtCvv" promptText="123" prefHeight="40.0"
                                           style="-fx-background-color: #0d1117; -fx-text-fill: white; -fx-prompt-text-fill: #8b949e; -fx-border-color: #30363d; -fx-border-radius: 8; -fx-background-radius: 8;" />
                            </VBox>
                        </HBox>

                        <VBox spacing="6.0">
                            <Label text="Nombre en la tarjeta" textFill="#c9d1d9" />
                            <TextField fx:id="txtNombreTarjeta" promptText="Como aparece en la tarjeta" prefHeight="40.0"
                                       style="-fx-background-color: #0d1117; -fx-text-fill: white; -fx-prompt-text-fill: #8b949e; -fx-border-color: #30363d; -fx-border-radius: 8; -fx-background-radius: 8;" />
                        </VBox>

                    </VBox>

                    <VBox spacing="12.0" style="-fx-background-color: #161b22; -fx-background-radius: 12; -fx-padding: 20;">
                        <Label text="Direccion de facturacion" textFill="#00d4ff">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <CheckBox fx:id="chkMismaDireccion" text="Usar la misma direccion de entrega" textFill="#c9d1d9" selected="true" />
                    </VBox>

                    <Button fx:id="btnConfirmarPago" text="Confirmar y pagar" maxWidth="Infinity" onAction="#onConfirmarPago"
                            style="-fx-background-color: #00d4ff; -fx-text-fill: #0d1117; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 14;" />

                    <Hyperlink fx:id="linkVolverCarrito" text="Volver al carrito" textFill="#8b949e" 
                               style="-fx-border-color: transparent;" onAction="#onVolverCarrito" />

                </VBox>

                <!-- Columna derecha - Resumen -->
                <VBox spacing="18.0" prefWidth="320">

                    <VBox spacing="14.0" style="-fx-background-color: #161b22; -fx-background-radius: 12; -fx-padding: 22;">
                        <Label text="Resumen de tu pedido" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <VBox fx:id="contenedorResumen" spacing="10.0">
                            <!-- Se llena desde el controller -->
                        </VBox>

                        <Separator />

                        <HBox>
                            <Label text="Subtotal" textFill="#8b949e" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblSubtotal" text="\$0.00" textFill="WHITE" />
                        </HBox>

                        <HBox>
                            <Label text="Envio" textFill="#8b949e" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Gratis" textFill="#3fb950" />
                        </HBox>

                        <Separator />

                        <HBox>
                            <Label text="Total a pagar" textFill="WHITE">
                                <font>
                                    <Font name="System Bold" size="15.0" />
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTotal" text="\$0.00" textFill="#00d4ff">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                            </Label>
                        </HBox>
                    </VBox>

                    <Label text="Tus datos estan protegidos. Este es un entorno de demostracion academica." 
                           textFill="#8b949e" wrapText="true" />

                </VBox>

            </HBox>
        </ScrollPane>
    </center>

</BorderPane>
