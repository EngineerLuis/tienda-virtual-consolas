<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #0d1117;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MisPedidosController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #161b22; -fx-padding: 12 25 12 25;">
            <Label text="nexo" textFill="#00d4ff">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Hyperlink fx:id="linkVolverCuenta" text="Volver a Mi Cuenta" textFill="#c9d1d9" 
                       style="-fx-border-color: transparent;" onAction="#onVolverCuenta" />
        </HBox>
    </top>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 30;">
            
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label text="Mis Pedidos" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label fx:id="lblCantidadPedidos" text="0 pedidos" textFill="#8b949e" />
            </HBox>

            <Label text="Aqui puedes ver el historial de tus compras." textFill="#8b949e" />

            <!-- Contenedor dinámico de pedidos -->
            <VBox fx:id="contenedorPedidos" spacing="14.0">
                <!-- Los pedidos se agregan desde el Controller -->
            </VBox>

        </VBox>
    </center>

</BorderPane>