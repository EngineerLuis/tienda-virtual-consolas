<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #0d1117;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ClientesController">

    <!-- MENÚ LATERAL -->
    <left>
        <VBox prefWidth="220.0" spacing="8.0" style="-fx-background-color: #161b22; -fx-padding: 20 15 20 15;">
            <Label text="nexo" textFill="#00d4ff">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            
            <Region prefHeight="20.0" />
            
            <Button fx:id="btnInventario" text="Inventario" maxWidth="Infinity" onAction="#onInventario"
                    style="-fx-background-color: transparent; -fx-text-fill: #c9d1d9; -fx-background-radius: 6; -fx-cursor: hand;" />
            
            <Button fx:id="btnVentas" text="Ventas" maxWidth="Infinity" onAction="#onVentas"
                    style="-fx-background-color: transparent; -fx-text-fill: #c9d1d9; -fx-background-radius: 6; -fx-cursor: hand;" />
            
            <Button fx:id="btnClientes" text="Clientes" maxWidth="Infinity" onAction="#onClientes"
                    style="-fx-background-color: #00d4ff; -fx-text-fill: #0d1117; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
            
            <Button fx:id="btnConfiguracion" text="Configuración" maxWidth="Infinity" onAction="#onConfiguracion"
                    style="-fx-background-color: transparent; -fx-text-fill: #c9d1d9; -fx-background-radius: 6; -fx-cursor: hand;" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button fx:id="btnVolverTienda" text="Volver a la tienda" maxWidth="Infinity" onAction="#onVolverTienda"
                    style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-background-radius: 6; -fx-cursor: hand;" />
        </VBox>
    </left>

    <!-- CONTENIDO -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 25;">
            
            <Label text="Clientes" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="22.0" />
                </font>
            </Label>

            <!-- Tarjetas de resumen -->
            <HBox spacing="15.0">
                <VBox spacing="4.0" style="-fx-background-color: #161b22; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="200">
                    <Label text="Clientes de prueba" textFill="#8b949e" />
                    <Label fx:id="lblTotalClientes" text="5" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                </VBox>
                
                <VBox spacing="4.0" style="-fx-background-color: #161b22; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="200">
                    <Label text="Pedidos asociados" textFill="#8b949e" />
                    <Label fx:id="lblPedidos" text="8" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                </VBox>
                
                <VBox spacing="4.0" style="-fx-background-color: #161b22; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="200">
                    <Label text="Ingreso acumulado" textFill="#8b949e" />
                    <Label fx:id="lblIngreso" text="$2,368.00" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Tabla de clientes -->
            <TableView fx:id="tablaClientes" prefHeight="380.0" style="-fx-background-color: #161b22;">
                <columns>
                    <TableColumn fx:id="colNombre" text="Cliente" prefWidth="200" />
                    <TableColumn fx:id="colEmail" text="Correo electrónico" prefWidth="250" />
                    <TableColumn fx:id="colPedidos" text="Pedidos" prefWidth="100" />
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120" />
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>