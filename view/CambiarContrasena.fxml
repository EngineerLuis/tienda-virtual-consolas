<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #0d1117;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CambiarContrasenaController">
    
    <HBox prefHeight="700.0" prefWidth="1100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
     
        <VBox alignment="CENTER_LEFT" prefWidth="550.0" style="-fx-background-color: #0d1117;" spacing="18.0">
            <padding>
                <Insets bottom="40.0" left="50.0" right="40.0" top="40.0" />
            </padding>
            
            <Label text="nexo" textFill="#00d4ff">
                <font>
                    <Font name="System Bold" size="22.0" />
                </font>
            </Label>
            
            <Label text="TU PRÓXIMO NIVEL EMPIEZA AQUÍ" textFill="#8b949e" style="-fx-background-color: #21262d; -fx-padding: 4 10 4 10; -fx-background-radius: 4;">
                <font>
                    <Font size="11.0" />
                </font>
            </Label>
           
            <Label text="Conecta con lo que más&#10;te gusta." textFill="WHITE" wrapText="true">
                <font>
                    <Font name="System Bold" size="34.0" />
                </font>
            </Label>
           
            <Label text="Consolas, juegos y tecnología para tu próxima partida. Todo en un solo lugar." textFill="#8b949e" wrapText="true" maxWidth="420">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <HBox spacing="25.0">
                <Label text="✓  Envío gratis desde $50" textFill="#8b949e" />
                <Label text="✓  Tecnología con garantía" textFill="#8b949e" />
            </HBox>
        </VBox>
        
        <VBox alignment="CENTER" prefWidth="550.0" spacing="16.0" style="-fx-background-color: #161b22;">
            <padding>
                <Insets bottom="50.0" left="70.0" right="70.0" top="50.0" />
            </padding>
            
            <Label text="NUEVA CONTRASEÑA" textFill="#00d4ff">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            
            <Label text="Cambia tu contraseña" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            
            <Label text="Ingresa y confirma tu nueva contraseña." textFill="#8b949e" wrapText="true" />
           
            <VBox spacing="6.0">
                <Label text="Nueva contraseña" textFill="#c9d1d9" />
                <PasswordField fx:id="txtNuevaPassword" promptText="••••••••" prefHeight="44.0" 
                               style="-fx-background-color: #0d1117; -fx-text-fill: white; -fx-prompt-text-fill: #8b949e; -fx-border-color: #30363d; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12;" />
            </VBox>
            
            <VBox spacing="6.0">
                <Label text="Confirmar nueva contraseña" textFill="#c9d1d9" />
                <PasswordField fx:id="txtConfirmarPassword" promptText="••••••••" prefHeight="44.0" 
                               style="-fx-background-color: #0d1117; -fx-text-fill: white; -fx-prompt-text-fill: #8b949e; -fx-border-color: #30363d; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12;" />
            </VBox>
            
            <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#onActualizar" 
                    prefHeight="48.0" maxWidth="Infinity" 
                    style="-fx-background-color: #00d4ff; -fx-text-fill: #0d1117; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" 
                    text="→   Cambiar contraseña" />
            
        </VBox>
    </HBox>
</AnchorPane>