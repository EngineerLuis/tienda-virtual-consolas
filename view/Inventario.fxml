<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #0d1117;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.InventarioController">

    <!-- MENÚ LATERAL -->
    <left>
        <VBox prefWidth="220.0" spacing="8.0" style="-fx-background-color: #161b22; -fx-padding: 20 15 20 15;">
            <Label text="nexo" textFill="#00d4ff" style="-fx-font-weight: bold; -fx-font-size: 20px;" />
            
            <Region prefHeight="20.0" />
            
            <Button fx:id="btnInventario" text="Inventario" maxWidth="Infinity" onAction="#onInventario"
                    style="-fx-background-color: #00d4ff; -fx-text-fill: #0d1117; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
            
            <Button fx:id="btnVentas" text="Ventas" maxWidth="Infinity" onAction="#onVentas"
                    style="-fx-background-color: transparent; -fx-text-fill: #c9d1d9; -fx-background-radius: 6; -fx-cursor: hand;" />
            
            <Button fx:id="btnClientes" text="Clientes" maxWidth="Infinity" onAction="#onClientes"
                    style="-fx-background-color: transparent; -fx-text-fill: #c9d1d9; -fx-background-radius: 6; -fx-cursor: hand;" />
            
            <Button fx:id="btnConfiguracion" text="Configuración" maxWidth="Infinity" onAction="#onConfiguracion"
                    style="-fx-background-color: transparent; -fx-text-fill: #c9d1d9; -fx-background-radius: 6; -fx-cursor: hand;" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button fx:id="btnVolverTienda" text="Volver a la tienda" maxWidth="Infinity" onAction="#onVolverTienda"
                    style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-background-radius: 6; -fx-cursor: hand;" />
        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 25;">
            
            <!-- Título y botón agregar -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label text="Inventario y ventas" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 22px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAgregarProducto" text="+ Agregar Nuevo Producto" onAction="#onAgregarProducto"
                        style="-fx-background-color: #00d4ff; -fx-text-fill: #0d1117; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 16;" />
            </HBox>

            <!-- Tarjetas de resumen -->
            <HBox spacing="15.0">
                <VBox spacing="4.0" style="-fx-background-color: #161b22; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="180">
                    <Label text="Ingresos de demostración" textFill="#8b949e" />
                    <Label fx:id="lblIngresos" text="0" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                </VBox>
                
                <VBox spacing="4.0" style="-fx-background-color: #161b22; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="180">
                    <Label text="Pedidos de demostración" textFill="#8b949e" />
                    <Label fx:id="lblPedidos" text="8" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                </VBox>
                
                <VBox spacing="4.0" style="-fx-background-color: #161b22; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="180">
                    <Label text="Ticket promedio" textFill="#8b949e" />
                    <Label fx:id="lblTicket" text="0" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                </VBox>
                
                <VBox spacing="4.0" style="-fx-background-color: #161b22; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="180">
                    <Label text="Productos" textFill="#8b949e" />
                    <Label fx:id="lblProductos" text="97" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                </VBox>
            </HBox>

            <!-- Tabla de productos -->
            <TableView fx:id="tablaProductos" prefHeight="350.0" style="-fx-background-color: #161b22;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="220" />
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120" />
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="80" />
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100" />
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="150" />
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane> 
